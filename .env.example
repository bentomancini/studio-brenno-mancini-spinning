# Server-only. Do NOT add NEXT_PUBLIC_ aliases for these keys.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RATE_LIMIT_SECRET=replace-with-independent-random-secret-at-least-32-characters
# Only set behind a proxy that strips/replaces this header. Empty = shared unknown-IP bucket.
TRUSTED_CLIENT_IP_HEADER=
# No production defaults or commercial policies are configured by environment variables.
# Policies are stored/versioned in PostgreSQL via the admin API (see docs/SETUP.md).
